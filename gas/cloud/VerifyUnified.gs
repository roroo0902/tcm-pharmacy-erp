 if(!d||d.kind!=='tcm-loss-cumulative'||d.version!==3||!Array.isArray(d.lines)||(!d.lines.length&&!d.completionSheets?.length)||d.lines.length>1000)throw Error('耗損清單格式不符或未填數量');
