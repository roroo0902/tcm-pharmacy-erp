function loss3Html_(payload){return '<!doctype html><meta charset="utf-8"><style>body{font:16px system-ui;color:#174c41;background:#f6f6ef;padding:24px}textarea{width:95%;height:85px;font-size:16px}button{min-height:44px;font:inherit;padding:12px 20px;margin:8px;border:0;border-radius:8px;background:#205c4c;color:white}pre{white-space:pre-wrap;overflow-wrap:anywhere;background:white;padding:20px}button:disabled{opacity:.5}</style><h2>每日耗損｜當日累計</h2><p>耗損以整瓶計算，不接受小數。相同數量不重扣；增加只扣差額；調低或歸零須填更正原因。</p><label id="draft-label">耗損清單<textarea id="draft"></textarea></label><button id="preview">預覽累計</button><pre id="result">先預覽，再確認入帳。</pre><button id="commit" disabled>確認差額入帳</button><script>const draft=document.getElementById("draft"),out=document.getElementById("result"),p=document.getElementById("preview"),b=document.getElementById("commit");draft.value='+JSON.stringify(payload).replace(/</g,'\\u003c')+';document.getElementById("draft-label").hidden=!!draft.value;let token,reviewed;draft.oninput=()=>{b.disabled=true;};p.onclick=()=>{b.disabled=true;p.disabled=true;reviewed=draft.value;out.textContent="正在核對雲端…";const readPreview=()=>{google.script.run.withSuccessHandler(r=>{token=r.token;out.textContent=r.lines.map(x=>x.date+" "+x.sheet+" "+x.code+" "+x.name+"：已入帳 "+x.before+" → 累計 "+x.total+"；"+(x.delta>=0?"扣除 ":"加回 ")+Math.abs(x.delta)+" 瓶；庫存 "+x.stock+" → "+x.stockAfter+(x.reason?"；原因："+x.reason:"")).join("\\n");b.disabled=false;p.disabled=false;}).withFailureHandler(e=>{out.textContent=e.message;p.disabled=false;}).lossV3Preview(reviewed);};google.script.run.withSuccessHandler(readPreview).withFailureHandler(e=>{out.textContent=e.message;p.disabled=false;}).lossV3PrepareDate(reviewed);};b.onclick=()=>{b.disabled=true;p.disabled=true;google.script.run.withSuccessHandler(r=>{out.textContent=r.message+" "+r.warning;p.disabled=false;}).withFailureHandler(e=>{out.textContent=e.message;p.disabled=false;}).lossV3Commit(reviewed,token);};</script>';}

